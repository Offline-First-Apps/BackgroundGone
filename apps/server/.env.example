# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3001
# Public URL of the web app (used for Dodo payment return URLs)
WEB_URL=http://localhost:3001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/backgroundgone?schema=public

# Dodo Payments — https://app.dodopayments.com (Developer > API / Webhooks)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=prod_xxxxxxxxxxxx
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
