# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3001
# Public URL of the web app (used for Dodo payment return URLs)
WEB_URL=http://localhost:3001
# Public URL of THIS server (used to build email download links). Optional in
# production — if unset it's auto-detected from the reverse-proxy's forwarded
# headers. Set it only if you want to force a specific host.
SERVER_PUBLIC_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/backgroundgone?schema=public

# Dodo Payments — https://app.dodopayments.com (Developer > API / Webhooks)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=prod_xxxxxxxxxxxx
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Email (nodemailer over Gmail SMTP). SMTP_PASS must be a Gmail *App Password*
# (Google Account > Security > 2-Step Verification > App passwords), NOT your
# normal password. Leave user/pass blank to disable email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=BackgroundGone <you@gmail.com>

# Direct-download URL of the installer (e.g. an S3/R2 link that forces
# attachment). The purchase-email button redirects here.
DOWNLOAD_URL=https://your-bucket.example.com/BackgroundGone-Setup.msi
