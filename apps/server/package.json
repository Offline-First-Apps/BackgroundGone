{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@backgroundgone/db": "workspace:*",
    "@backgroundgone/env": "workspace:*",
    "dodopayments": "^2.42.2",
    "dotenv": "catalog:",
    "hono": "^4.12.27",
    "standardwebhooks": "^1.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@backgroundgone/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
  }
}
