# Dependencies (reinstalled inside the image)
**/node_modules

# Build outputs / caches
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo

# Prisma generated client (regenerated during the image build)
packages/db/prisma/generated

# Secrets and local env — never bake these into an image
**/.env
**/.env.*.local

# VCS / editor / OS
.git
.gitignore
**/.DS_Store
**/*.log

# Not needed by the web/server images
apps/desktop
