{
  "name": "backgroundgone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:desktop": "turbo run dev -F desktop",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @backgroundgone/db",
    "db:studio": "turbo run db:studio -F @backgroundgone/db",
    "db:generate": "turbo run db:generate -F @backgroundgone/db",
    "db:migrate": "turbo run db:migrate -F @backgroundgone/db",
    "db:local": "turbo run db:local -F @backgroundgone/db"
  },
  "dependencies": {
    "@backgroundgone/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@backgroundgone/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.4.0"
}
